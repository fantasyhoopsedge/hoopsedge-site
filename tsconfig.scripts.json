// Typechecks the data-pipeline scripts.
//
// tsconfig.json EXCLUDES "scripts", so `tsc -p tsconfig.json` has never looked
// at them — a missing import in build-player-identity.ts slipped past both tsc
// and eslint on 2026-08-03 because of it. This config covers them.
//
//   npm run typecheck:scripts
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    ".next",
    // Pre-existing TS2589: the compiler gives up on the dynamic `table` string
    // in that file's generic fetchAll helper. Not a defect, and not worth
    // rewriting a working audit script to satisfy — excluded rather than fixed
    // so this check stays green, and therefore stays read.
    "scripts/audit-player-teams-pass2.ts"
  ]
}
