# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Both values are safe to expose to the browser (RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. NEVER prefix with NEXT_PUBLIC_, never import in client code.
# Used by resolution jobs + the agent worker to award points, set outcomes,
# and write draft prediction games (bypasses RLS via the service role).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Autonomous agent worker (src/app/api/agent/generate-pitch) ───────────────
# Anthropic API key for Claude Opus 4.8. Server-only.
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY

# Shared secret that gates the agent worker route. The scheduler must send it as
#   Authorization: Bearer <CRON_SECRET>
# Generate a long random value (e.g. `openssl rand -hex 32`).
CRON_SECRET=YOUR-LONG-RANDOM-SECRET

# Discord incoming-webhook URL the agent posts each new draft to (rich embed +
# Approve link). Optional — if unset, drafts are still created, just not announced.
AGENT_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Canonical site origin, used to build the review link in the webhook payload.
# Falls back to the request origin if unset.
NEXT_PUBLIC_SITE_URL=https://fantasyhoopsedge.com
