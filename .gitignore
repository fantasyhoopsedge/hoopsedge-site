# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets / scratch (never commit DB passwords, dumps, etc.)
supabase/*.txt
.tmp

# Claude Code internal worktrees
.claude/worktrees/

# NBA pipeline: regenerated each salary ingest; raw HoopsHype staging paste
data/nba-salaries/_unmatched.json
data/nba-salaries/current_raw.csv

# Rookie board editor: unpublished work-in-progress draft (local only)
src/data/rookie-board.draft.json

# Generated build artifacts (regeneratable from Supabase, not committed source data).
# player-trends now lives in the nba_player_trends table (trends:build pushes it);
# the local JSON is a --file debug artifact only.
/output/

# Projection models (models/) are Python, run outside Next under their own venv.
__pycache__/
*.py[cod]
.venv/

# hoopR player-box parquet cache: large, and re-downloaded on demand by
# common.ensure_parquet(). Override the location with FHE_PARQUET_CACHE.
data/draft-model/parquet/
