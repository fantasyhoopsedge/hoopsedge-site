# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local secrets / scratch (never commit DB passwords, dumps, etc.)
supabase/*.txt
.tmp

# Claude Code internal worktrees
.claude/worktrees/

# NBA pipeline: regenerated each salary ingest; raw HoopsHype staging paste
data/nba-salaries/_unmatched.json
data/nba-salaries/current_raw.csv

# Rookie board editor: unpublished work-in-progress draft (local only)
src/data/rookie-board.draft.json

# Generated build artifacts (regeneratable from Supabase, not committed source data)
/output/
